; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section]
;   param=value

config_version=5

[application]

config/name="Ludus Gladiator Simulator"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.5")

[debug]

gdscript/warnings/treat_warnings_as_errors=false
gdscript/warnings/integer_division=0
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[autoload]

GameState="*res://scripts/core/game_state.gd"
DataRepository="*res://scripts/core/data_repository.gd"
RosterManager="*res://scripts/systems/roster_manager.gd"
LudusOwnerManager="*res://scripts/systems/ludus_owner_manager.gd"
MarketManager="*res://scripts/systems/market_manager.gd"
EstateManager="*res://scripts/systems/estate_manager.gd"
EquipmentManager="*res://scripts/systems/equipment_manager.gd"
CombatManager="*res://scripts/systems/combat_manager_weekly.gd"
CombatHistoryManager="*res://scripts/systems/combat_history_manager.gd"
SaveManager="*res://scripts/core/save_manager.gd"
RivalManager="*res://scripts/systems/rival_manager.gd"
EventManager="*res://scripts/systems/event_manager.gd"
EconomyManager="*res://scripts/systems/economy_manager.gd"
TournamentManager="*res://scripts/systems/tournament_manager.gd"
CampaignManager="*res://scripts/systems/campaign_manager.gd"
PersonalityManager="*res://scripts/systems/personality_manager.gd"
RelationshipManager="*res://scripts/systems/relationship_manager.gd"
GladiatorProgressionManager="*res://scripts/systems/gladiator_progression_manager.gd"
TransferManager="*res://scripts/systems/transfer_manager.gd"
EquipmentAbilityGuard="*res://scripts/systems/equipment_ability_guard.gd"
TraitManager="*res://scripts/systems/trait_manager.gd"
RosterMarketPresentation="*res://scripts/ui/roster_market_presentation.gd"
AllTabsUIBootstrap="*res://scripts/ui/all_tabs_ui_bootstrap.gd"
WeeklyCyclePresentation="*res://scripts/ui/weekly_cycle_presentation.gd"
WeeklyCalendarPresenter="*res://scripts/ui/weekly_calendar_presenter.gd"
StartScreenController="*res://scripts/ui/start_screen_controller.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
