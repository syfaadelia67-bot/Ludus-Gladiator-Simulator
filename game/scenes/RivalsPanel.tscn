[gd_scene load_steps=2 format=3]

[ext_resource path="res://scripts/ui/rivals_panel.gd" type="Script" id="1"]

[node name="Rivales" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="Navigation" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="BackToFinca" type="Button" parent="Navigation"]
layout_mode = 2
text = "← Volver a la finca"
tooltip_text = "Regresar al centro del ludus."

[node name="Title" type="Label" parent="Navigation"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "RIVALES E INTRIGA"
horizontal_alignment = 1

[node name="Tension" type="Label" parent="Navigation"]
layout_mode = 2
horizontal_alignment = 2
text = "Tensión regional: 0"

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="RivalOperations" type="HSplitContainer" parent="Scroll/Content"]
custom_minimum_size = Vector2(0, 360)
layout_mode = 2
split_offset = 430

[node name="RivalList" type="ItemList" parent="Scroll/Content/RivalOperations"]
custom_minimum_size = Vector2(360, 320)
layout_mode = 2
size_flags_vertical = 3

[node name="OperationPanel" type="VBoxContainer" parent="Scroll/Content/RivalOperations"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="RivalDetails" type="RichTextLabel" parent="Scroll/Content/RivalOperations/OperationPanel"]
custom_minimum_size = Vector2(500, 120)
layout_mode = 2
bbcode_enabled = true
text = "Seleccioná un ludus rival."

[node name="AgentLabel" type="Label" parent="Scroll/Content/RivalOperations/OperationPanel"]
layout_mode = 2
text = "Agente asignado a Espionaje"

[node name="AgentSelector" type="OptionButton" parent="Scroll/Content/RivalOperations/OperationPanel"]
layout_mode = 2

[node name="OperationLabel" type="Label" parent="Scroll/Content/RivalOperations/OperationPanel"]
layout_mode = 2
text = "Operación"

[node name="OperationSelector" type="OptionButton" parent="Scroll/Content/RivalOperations/OperationPanel"]
layout_mode = 2

[node name="OperationDetails" type="RichTextLabel" parent="Scroll/Content/RivalOperations/OperationPanel"]
custom_minimum_size = Vector2(500, 135)
layout_mode = 2
bbcode_enabled = true
text = "Seleccioná una operación."

[node name="ExecuteOperation" type="Button" parent="Scroll/Content/RivalOperations/OperationPanel"]
layout_mode = 2
text = "Ejecutar operación"

[node name="ResultLabel" type="Label" parent="Scroll/Content"]
layout_mode = 2
text = "INFORMES DE INTELIGENCIA"

[node name="ResultLog" type="RichTextLabel" parent="Scroll/Content"]
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
bbcode_enabled = true
scroll_following = true
text = "[b]La red de informantes espera órdenes.[/b]"
