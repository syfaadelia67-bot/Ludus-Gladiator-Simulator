[gd_scene load_steps=2 format=3]

[ext_resource path="res://scripts/ui/tournaments_panel.gd" type="Script" id="1"]

[node name="Torneos" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="Navigation" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="BackToFinca" type="Button" parent="Navigation"]
layout_mode = 2
text = "← Volver a la finca"
tooltip_text = "Regresar al centro del ludus."

[node name="Title" type="Label" parent="Navigation"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "CALENDARIO DE COMBATES"
horizontal_alignment = 1

[node name="Status" type="Label" parent="Navigation"]
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 2
autowrap_mode = 2
text = "Elegí un evento y un gladiador disponible."

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="TournamentContent" type="HSplitContainer" parent="Scroll/Content"]
custom_minimum_size = Vector2(0, 430)
layout_mode = 2
split_offset = 470

[node name="EventList" type="ItemList" parent="Scroll/Content/TournamentContent"]
custom_minimum_size = Vector2(400, 380)
layout_mode = 2
size_flags_vertical = 3

[node name="Right" type="VBoxContainer" parent="Scroll/Content/TournamentContent"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Details" type="RichTextLabel" parent="Scroll/Content/TournamentContent/Right"]
custom_minimum_size = Vector2(450, 180)
layout_mode = 2
bbcode_enabled = true
text = "Seleccioná un evento."

[node name="FighterSelector" type="OptionButton" parent="Scroll/Content/TournamentContent/Right"]
layout_mode = 2

[node name="Accept" type="Button" parent="Scroll/Content/TournamentContent/Right"]
layout_mode = 2
text = "Aceptar contrato de combate"

[node name="ContractsTitle" type="Label" parent="Scroll/Content/TournamentContent/Right"]
layout_mode = 2
text = "COMBATES PROGRAMADOS"

[node name="Contracts" type="ItemList" parent="Scroll/Content/TournamentContent/Right"]
