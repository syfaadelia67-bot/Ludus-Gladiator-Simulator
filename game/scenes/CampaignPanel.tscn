[gd_scene load_steps=2 format=3]

[ext_resource path="res://scripts/ui/campaign_panel.gd" type="Script" id="1"]

[node name="Campaña" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="Navigation" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="BackToFinca" type="Button" parent="Navigation"]
layout_mode = 2
text = "← Volver a la finca"
tooltip_text = "Regresar al mapa principal del ludus."

[node name="Title" type="Label" parent="Navigation"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 21
text = "CAMPAÑA Y LEGADO DEL LUDUS"
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Rank" type="Label" parent="Scroll/Content"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 19
text = "Progreso del ludus"
autowrap_mode = 3

[node name="NextRank" type="RichTextLabel" parent="Scroll/Content"]
custom_minimum_size = Vector2(0, 92)
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
text = "Próximo rango"

[node name="Ending" type="RichTextLabel" parent="Scroll/Content"]
custom_minimum_size = Vector2(0, 66)
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
text = "Meta final"

[node name="ObjectivesTitle" type="Label" parent="Scroll/Content"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 19
text = "OBJETIVOS DE CAMPAÑA"

[node name="ObjectivesList" type="VBoxContainer" parent="Scroll/Content"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="FooterHint" type="Label" parent="Scroll/Content"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3
text = "Los objetivos se actualizan automáticamente al avanzar semanas, combatir y mejorar el ludus."
