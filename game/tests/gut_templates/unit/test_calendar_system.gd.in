extends GutTest

const TOURNAMENT_MANAGER_SCRIPT := preload("res://scripts/systems/tournament_manager_weekly.gd")

var manager

func before_each() -> void:
    manager = autofree(TOURNAMENT_MANAGER_SCRIPT.new())

func test_campaign_uses_one_month_per_visible_turn() -> void:
    assert_eq(GameState.get_month(), maxi(1, GameState.day))
    assert_eq(GameState.get_week(), GameState.get_month())

func test_normal_month_has_underworld_and_one_or_two_official_tournaments() -> void:
    var schedule: Array = manager.get_month_schedule(1)
    assert_between(schedule.size(), 2, 3)
    assert_eq(_count_competition(schedule, "underworld"), 1)
    assert_between(_count_competition(schedule, "official_minor"), 1, 2)
    assert_eq(_count_competition(schedule, "grand_tournament"), 0)

func test_campaign_chapter_boundaries_match_the_twenty_month_demo() -> void:
    assert_eq(str(CampaignManager.get_chapter_for_month(1).get("id", "")), "ruins")
    assert_eq(str(CampaignManager.get_chapter_for_month(6).get("id", "")), "ruins")
    assert_eq(str(CampaignManager.get_chapter_for_month(7).get("id", "")), "blood_reputation")
    assert_eq(str(CampaignManager.get_chapter_for_month(12).get("id", "")), "blood_reputation")
    assert_eq(str(CampaignManager.get_chapter_for_month(13).get("id", "")), "name_of_ludus")
    assert_eq(str(CampaignManager.get_chapter_for_month(20).get("id", "")), "name_of_ludus")

func test_tournament_legacy_day_and_week_fields_migrate_to_month_fields() -> void:
    var entries: Array = [
        {"scheduled_day":3, "accepted_day":2, "resolved_day":4},
        {"scheduled_week":8}
    ]

    manager._migrate_month_fields(entries)

    assert_eq(int(entries[0].get("scheduled_month", -1)), 3)
    assert_eq(int(entries[0].get("scheduled_week", -1)), 3)
    assert_eq(int(entries[0].get("scheduled_day", -1)), 3)
    assert_eq(int(entries[0].get("accepted_month", -1)), 2)
    assert_eq(int(entries[0].get("accepted_week", -1)), 2)
    assert_eq(int(entries[0].get("accepted_day", -1)), 2)
    assert_eq(int(entries[0].get("resolved_month", -1)), 4)
    assert_eq(int(entries[0].get("resolved_week", -1)), 4)
    assert_eq(int(entries[0].get("resolved_day", -1)), 4)
    assert_eq(int(entries[1].get("scheduled_month", -1)), 8)
    assert_eq(int(entries[1].get("scheduled_week", -1)), 8)
    assert_eq(int(entries[1].get("scheduled_day", -1)), 8)

func test_grand_tournament_months_replace_regular_official_tournaments() -> void:
    for month in manager.GT1_ENCOUNTER_MONTHS:
        var schedule: Array = manager.get_month_schedule(int(month))
        assert_eq(schedule.size(), 2)
        assert_eq(_count_competition(schedule, "underworld"), 1)
        assert_eq(_count_competition(schedule, "grand_tournament"), 1)
        assert_eq(_count_competition(schedule, "official_minor"), 0)
    assert_eq(manager.GT1_ENCOUNTER_MONTHS, [13, 16, 20])
    assert_eq(manager.GT1_TOTAL_BOUTS, 9)
    assert_eq(manager.GT1_POINTS_PER_WIN, 3)

func test_minor_tournament_prizes_match_frozen_tiers() -> void:
    assert_eq(int(manager.MINOR_PRIZES[1].get("champion", 0)), 150)
    assert_eq(int(manager.MINOR_PRIZES[1].get("eliminated", 0)), 25)
    assert_eq(int(manager.MINOR_PRIZES[1].get("reputation", 0)), 25)
    assert_eq(int(manager.MINOR_PRIZES[1].get("points", 0)), 2)
    assert_eq(int(manager.MINOR_PRIZES[2].get("champion", 0)), 200)
    assert_eq(int(manager.MINOR_PRIZES[2].get("eliminated", 0)), 35)
    assert_eq(int(manager.MINOR_PRIZES[2].get("reputation", 0)), 40)
    assert_eq(int(manager.MINOR_PRIZES[2].get("points", 0)), 3)
    assert_eq(int(manager.MINOR_PRIZES[3].get("champion", 0)), 275)
    assert_eq(int(manager.MINOR_PRIZES[3].get("eliminated", 0)), 50)
    assert_eq(int(manager.MINOR_PRIZES[3].get("reputation", 0)), 60)
    assert_eq(int(manager.MINOR_PRIZES[3].get("points", 0)), 4)

func _count_competition(schedule: Array, competition: String) -> int:
    var count := 0
    for event in schedule:
        if str(event.get("competition", "")) == competition:
            count += 1
    return count
