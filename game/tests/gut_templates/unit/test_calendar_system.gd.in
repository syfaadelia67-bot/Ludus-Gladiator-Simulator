extends GutTest

const TOURNAMENT_MANAGER_SCRIPT := preload("res://scripts/systems/tournament_manager_weekly.gd")

var manager

func before_each() -> void:
    manager = autofree(TOURNAMENT_MANAGER_SCRIPT.new())

func test_campaign_uses_seven_internal_ticks_per_visible_week() -> void:
    assert_eq(GameState.DAYS_PER_WEEK, 7)
    assert_eq(GameState.get_week(), maxi(1, GameState.day))

func test_arena_event_rotation_is_deterministic() -> void:
    assert_eq(CombatManager.get_event_type_for_week(1), "exhibition")
    assert_eq(CombatManager.get_event_type_for_week(2), "underground")
    assert_eq(CombatManager.get_event_type_for_week(3), "beast_hunt")
    assert_eq(CombatManager.get_event_type_for_week(4), "official")
    assert_eq(CombatManager.get_event_type_for_week(12), "official")
    assert_eq(CombatManager.get_event_type_for_week(16), "demo_finale")

func test_campaign_chapter_boundaries_match_the_sixteen_week_demo() -> void:
    assert_eq(str(CampaignManager.get_chapter_for_week(1).get("id", "")), "ruins")
    assert_eq(str(CampaignManager.get_chapter_for_week(5).get("id", "")), "ruins")
    assert_eq(str(CampaignManager.get_chapter_for_week(6).get("id", "")), "blood_reputation")
    assert_eq(str(CampaignManager.get_chapter_for_week(11).get("id", "")), "blood_reputation")
    assert_eq(str(CampaignManager.get_chapter_for_week(12).get("id", "")), "name_of_ludus")
    assert_eq(str(CampaignManager.get_chapter_for_week(16).get("id", "")), "name_of_ludus")

func test_tournament_legacy_day_fields_migrate_to_week_fields() -> void:
    var entries: Array = [
        {"scheduled_day":3, "accepted_day":2, "resolved_day":4},
        {"scheduled_week":8}
    ]

    manager._migrate_week_fields(entries)

    assert_eq(int(entries[0].get("scheduled_week", -1)), 3)
    assert_eq(int(entries[0].get("scheduled_day", -1)), 3)
    assert_eq(int(entries[0].get("accepted_week", -1)), 2)
    assert_eq(int(entries[0].get("accepted_day", -1)), 2)
    assert_eq(int(entries[0].get("resolved_week", -1)), 4)
    assert_eq(int(entries[0].get("resolved_day", -1)), 4)
    assert_eq(int(entries[1].get("scheduled_week", -1)), 8)
    assert_eq(int(entries[1].get("scheduled_day", -1)), 8)

func test_tournament_calendar_offsets_cover_the_four_event_tiers() -> void:
    assert_eq(manager.WEEK_OFFSETS.size(), 4)
    assert_eq(int(manager.WEEK_OFFSETS.get("local_bout", 0)), 1)
    assert_eq(int(manager.WEEK_OFFSETS.get("forum_games", 0)), 2)
    assert_eq(int(manager.WEEK_OFFSETS.get("provincial_cup", 0)), 3)
    assert_eq(int(manager.WEEK_OFFSETS.get("imperial_trial", 0)), 4)
    assert_eq(manager.CALENDAR_BLOCK_WEEKS, 4)
