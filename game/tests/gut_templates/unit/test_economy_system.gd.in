extends GutTest

const ECONOMY_MANAGER_SCRIPT := preload("res://scripts/systems/economy_manager_weekly.gd")

var manager


func before_each() -> void:
    manager = autofree(ECONOMY_MANAGER_SCRIPT.new())


func test_monthly_projection_uses_only_frozen_operating_costs() -> void:
    manager.active_contracts.assign([
        {"monthly_income": 30, "months_remaining": 4},
        {"daily_income": 20, "days_remaining": 2},
    ])
    manager.active_loans.assign([
        {"installment": 25, "remaining": 10, "months_remaining": 3},
        {"installment": 12, "remaining": 30, "days_remaining": 4},
    ])

    var fixed_costs: int = manager.get_monthly_fixed_costs()
    var projection: Dictionary = manager.get_monthly_projection()

    assert_eq(str(projection.get("period", "")), "month")
    assert_eq(int(projection.get("sponsor_income", -1)), 0)
    assert_eq(int(projection.get("loan_payments", -1)), 0)
    assert_eq(int(projection.get("fixed_costs", -1)), fixed_costs)
    assert_eq(int(projection.get("net", 999999)), -fixed_costs)
    assert_eq(str(projection.get("sponsor_balance_status", "")), "pending_monthly_design")
    assert_eq(str(projection.get("loan_balance_status", "")), "pending_monthly_design")
    assert_eq(manager.get_total_debt(), 40)


func test_legacy_wrapper_has_no_daily_or_weekly_authority() -> void:
    var contract: Dictionary = manager.get_contract()

    assert_eq(str(contract.get("status", "")), "compatibility_only")
    assert_eq(str(contract.get("canonical_authority", "")), "monthly_economy_runtime")
    assert_false(bool(contract.get("weekly_scheduler_authority", true)))
    assert_false(bool(contract.get("daily_scheduler_authority", true)))
    assert_false(bool(contract.get("sponsor_balance_authority", true)))
    assert_false(bool(contract.get("loan_balance_authority", true)))
    assert_false(bool(contract.get("save_version_change_required", true)))


func test_export_import_preserves_monthly_runtime_state_without_schema_bump() -> void:
    manager.last_processed_month = 6
    manager.last_monthly_report = {
        "status": "resolved",
        "period": "month",
        "month": 6,
        "operating_costs": 88,
    }
    manager.active_loans.assign([{"remaining": 44}])

    var exported: Dictionary = manager.export_state()
    assert_eq(int(exported.get("last_processed_month", 0)), 6)
    assert_eq(int((exported.get("last_monthly_report", {}) as Dictionary).get("month", 0)), 6)

    var restored = autofree(ECONOMY_MANAGER_SCRIPT.new())
    restored.import_state(exported)
    assert_eq(restored.last_processed_month, 6)
    assert_eq(int(restored.last_monthly_report.get("operating_costs", 0)), 88)
    assert_eq(restored.get_total_debt(), 44)


func test_bankruptcy_legacy_thresholds_are_quarantined() -> void:
    manager.missed_payments = 6
    manager.insolvency_days = 20

    assert_eq(manager.get_bankruptcy_level(), 0)
    assert_true(manager.get_bankruptcy_message().contains("fuera del alcance"))


func test_sponsors_and_loans_fail_closed_without_mutating_legacy_state() -> void:
    var contracts_before: int = manager.active_contracts.size()
    var loans_before: int = manager.active_loans.size()
    var serial_before: int = manager.serial

    assert_false(manager.sign_contract("local_merchant"))
    assert_false(manager.take_loan("small"))

    assert_eq(manager.active_contracts.size(), contracts_before)
    assert_eq(manager.active_loans.size(), loans_before)
    assert_eq(manager.serial, serial_before)
    assert_false(bool(manager.get_sponsor("local_merchant").get("demo_available", true)))
    assert_false(bool(manager.get_loan_product("small").get("demo_available", true)))
    var contract: Dictionary = manager.get_monthly_runtime_contract()
    assert_true(bool(contract.get("unfrozen_actions_fail_closed", false)))
    assert_false(bool(contract.get("sponsor_demo_available", true)))
    assert_false(bool(contract.get("loan_demo_available", true)))
    assert_false(bool(contract.get("bankruptcy_demo_available", true)))
