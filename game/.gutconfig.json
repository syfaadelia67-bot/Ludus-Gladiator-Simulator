{
  "dirs": [
    "res://tests/gut/unit",
    "res://tests/gut/integration"
  ],
  "include_subdirs": true,
  "prefix": "test_",
  "suffix": ".gd",
  "tests": [],
  "selected": "",
  "unit_test_name": "",
  "should_exit": true,
  "should_exit_on_success": false,
  "ignore_pause": true,
  "log_level": 2,
  "hide_orphans": false,
  "compact_mode": true,
  "should_maximize": false,
  "disable_colors": false,
  "double_strategy": "script_only",
  "no_error_tracking": false,
  "failure_error_types": [
    "engine",
    "gut",
    "push_error"
  ],
  "junit_xml_file": "res://test-results/gut.xml",
  "junit_xml_timestamp": false
}
